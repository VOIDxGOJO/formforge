generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ActionType {
  SEND_EMAIL
  WEBHOOK
}

enum AdaptiveSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  memberships   Membership[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Workspace {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  memberships  Membership[]
  forms        Form[]
  inviteTokens InviteToken[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model InviteToken {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  token       String    @unique
  role        Role      @default(MEMBER)
  expiresAt   DateTime
  usedAt      DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Form {
  id                 String              @id @default(uuid())
  workspaceId        String
  name               String
  slug               String              @unique
  /// What the form is meant to find out; used by AI generation and coverage checks.
  objective          String?
  /// Field list; each field may carry metadata (informationTarget, estimatedSeconds, relevance, ...).
  fields             Json                @default("[]")
  /// Adaptive-mode settings (enabled, limits, stop rule, utility weights). Null = static form.
  adaptiveConfig     Json?
  isActive           Boolean             @default(true)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  workflows          Workflow[]
  qualityReports     QualityReport[]
  adaptiveSessions   AdaptiveSession[]
  modelSnapshots     ModelSnapshot[]
  syntheticResponses SyntheticResponse[]
  responseInsights   ResponseInsight[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([workspaceId])
  @@index([slug])
}

model Submission {
  id                String            @id @default(uuid())
  formId            String
  responses         Json
  /// Values predicted by the adaptive engine for skipped questions: { fieldId: { value, confidence } }.
  /// Kept apart from `responses` so predictions are never mistaken for real answers.
  imputed           Json?
  sessionId         String?           @unique
  ipAddress         String?
  userAgent         String?
  form              Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  session           AdaptiveSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  webhookDeliveries WebhookDelivery[]
  submittedAt       DateTime          @default(now())

  @@index([formId])
  @@index([submittedAt])
}

model Workflow {
  id        String         @id @default(uuid())
  formId    String
  name      String
  isActive  Boolean        @default(true)
  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([formId])
}

model WorkflowStep {
  id                String            @id @default(uuid())
  workflowId        String
  actionType        ActionType
  actionConfig      Json
  order             Int               @default(0)
  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]

  @@index([workflowId])
}

model WebhookDelivery {
  id                 String         @id @default(uuid())
  workflowStepId     String
  submissionId       String
  status             DeliveryStatus @default(PENDING)
  attemptCount       Int            @default(0)
  nextRetryAt        DateTime       @default(now())
  lastResponseBody   String?
  lastResponseStatus Int?
  workflowStep       WorkflowStep   @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  submission         Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, nextRetryAt])
  @@index([submissionId])
}

// ---------------------------------------------------------------- FormForge 2.0

model QualityReport {
  id               String   @id @default(uuid())
  formId           String
  score            Int
  /// [{ fieldId, type, severity, message, suggestion }]
  issues           Json
  estimatedSeconds Int
  form             Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([formId, createdAt])
}

/// Fitted respondent model (latent class model) used by adaptive sessions.
model ModelSnapshot {
  id          String            @id @default(uuid())
  formId      String
  /// Number of latent classes.
  k           Int
  /// Field ids in the order used by `theta` and `nmi`.
  questionIds String[]
  /// Class priors, length k.
  pi          Json
  /// theta[q][k][option] = P(option | class k).
  theta       Json
  /// Normalised mutual information between questions.
  nmi         Json
  nReal       Int
  nSynthetic  Int
  form        Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  sessions    AdaptiveSession[]
  createdAt   DateTime          @default(now())

  @@index([formId, createdAt])
}

/// A respondent part-way through an adaptive form.
model AdaptiveSession {
  id          String                @id @default(uuid())
  formId      String
  snapshotId  String?
  /// Field ids in the order they were asked.
  askedOrder  String[]
  answers     Json                  @default("{}")
  /// Posterior over latent classes after the last answer.
  posterior   Float[]
  status      AdaptiveSessionStatus @default(ACTIVE)
  form        Form                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  snapshot    ModelSnapshot?        @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  submission  Submission?
  startedAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?

  @@index([formId, status])
}

/// Warm-start answers written by the LLM for personas. Never shown as submissions.
model SyntheticResponse {
  id        String   @id @default(uuid())
  formId    String
  persona   String
  responses Json
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([formId])
}

/// Cached response intelligence for a form's open-text answers.
model ResponseInsight {
  id        String   @id @default(uuid())
  formId    String
  summary   String
  topics    Json
  sentiment Json
  clusters  Json
  /// Number of submissions the insight was computed from.
  basedOn   Int
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}
